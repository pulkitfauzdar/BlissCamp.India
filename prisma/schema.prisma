// Blisscamp India — database schema
// Running on Supabase Postgres. DATABASE_URL is the pooled connection (used
// by the app), DIRECT_URL is the direct connection (used only for
// migrations/db push) — see README.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Trek {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  region      String
  difficulty  String // Easy | Moderate | Challenging | Demanding
  durationDays Int
  maxAltitudeM Int
  pricePerPersonPaise Int // price in the smallest currency unit (paise for INR)
  groupSizeMax Int
  summary     String
  description String
  highlights  String // JSON string array
  inclusions  String // JSON string array
  exclusions  String // JSON string array
  itinerary   String // JSON array of { day, title, description, elevationM }
  images      String // JSON string array of image URLs
  featured    Boolean  @default(false)
  badge       String? // short label on the card, e.g. "Bestseller"
  seasons     String   @default("[]") // JSON array: Winter | Spring | Summer | Monsoon | Autumn
  bestMonths  String   @default("[]") // JSON array of month numbers, 1-12
  themes      String   @default("[]") // JSON array, e.g. "Snow", "Beginner", "Summit a peak"
  startPoint  String   @default("")   // base camp / pickup, e.g. "Sankri (from Dehradun)"
  distanceKm  Int      @default(0)
  fitness     String   @default("")   // what fitness this trek needs
  howToReach  String   @default("")
  faqs        String   @default("[]") // JSON array of { q, a }
  lat         Float    @default(0) // map pin: summit or main highlight
  lng         Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  departures Departure[]
  bookings   Booking[]
}

model Departure {
  id        String   @id @default(cuid())
  trekId    String
  trek      Trek     @relation(fields: [trekId], references: [id], onDelete: Cascade)
  date      DateTime
  capacity  Int
  booked    Int      @default(0)
  createdAt DateTime @default(now())

  bookings Booking[]

  @@index([trekId, date])
}

model Booking {
  id              String   @id @default(cuid())
  trekId          String
  trek            Trek     @relation(fields: [trekId], references: [id])
  departureId     String
  departure       Departure @relation(fields: [departureId], references: [id])
  travelers       Int
  name            String
  email           String
  phone           String
  amountPaise     Int
  currency        String   @default("inr")
  status          String   @default("pending") // pending | confirmed | cancelled
  stripeSessionId String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
}
