# Database. For local dev, SQLite works out of the box.
# For production, point this at Postgres/MySQL/PlanetScale/Neon/Supabase etc.
# and change the "provider" in prisma/schema.prisma to match.
DATABASE_URL="file:./dev.db"

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Public site URL, used to build Stripe success/cancel redirect links.
# Set this to your real domain in production (e.g. https://blisscampindia.com)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Currency for all prices, as a lowercase ISO code Stripe accepts (e.g. inr, usd)
NEXT_PUBLIC_CURRENCY="inr"
